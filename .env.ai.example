# Copy to .env.ai and chmod 600. All example values are blank.
# Lite uses low reasoning; free-mode prices are derived as zero.
# Keep disabled and free confirmation false during operations preparation.
# Current baseline: docs/CURRENT_OPERATING_BASELINE.md. Staff shared daily cap=40.
AI_ENABLED=
# gemini
AI_PROVIDER=
# Only gemini-3.5-flash-lite is supported.
AI_MODEL=
# Server-only key. Read only from .env.ai; never enter a real key here.
AI_GEMINI_API_KEY=
# free; no automatic paid/model fallback.
AI_USAGE_TIER=
# Set true only after verifying the project is Free Tier.
AI_FREE_TIER_CONFIRMED=
# Google project ID whose limits you checked in AI Studio.
AI_FREE_PROJECT_ID=
# Actual model-specific requests/minute from AI Studio.
AI_FREE_RPM=
# Actual input tokens/minute from AI Studio.
AI_FREE_TPM=
# Actual requests/day from AI Studio (Pacific reset).
AI_FREE_RPD=
# New operating budget is 0 USD. Historical budgets do not authorize paid use.
AI_MONTHLY_BUDGET_USD=
# Separate cumulative test budget: 0 USD; never reset a campaign ledger.
AI_TEST_BUDGET_USD=
# Stable test campaign name; keep it unchanged to preserve its cap.
AI_TEST_BUDGET_SCOPE=
