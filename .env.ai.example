# Copy this file to .env.ai locally. Never enter real keys in this example.
# Load .env.ai explicitly on the server; never expose it to browser code.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
AI_MONTHLY_BUDGET_USD=5
AI_API_KEY=
# Verify current official prices for the selected model before enabling AI.
AI_INPUT_USD_PER_MILLION=0.10
AI_OUTPUT_USD_PER_MILLION=0.50
