DJANGO_SECRET_KEY=local-fake-key-change-before-production-2026-11-03
DJANGO_DEBUG=false
TM_WEB_WORKERS=2
TM_WEB_THREADS=4
# 0 keeps automatic request-count recycling disabled.
TM_WEB_MAX_REQUESTS=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=postgresql://tm:tm-local-only@127.0.0.1:55432/tm_dev
TEST_DATABASE_NAME=test_tm_dev
APP_TIMEZONE=Asia/Seoul
ALLOW_DEMO_SEED=true
SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_REQUEST_FAILURE_LIMIT=30
BUSINESS_LOCK_TIMEOUT_MS=5000
# Specification defaults below are fixed unless their setting is documented as configurable.
AUTO_RECALL_HOUR=23
AUTOSAVE_TARGET_SECONDS=90
AUTOSAVE_MAX_SECONDS=100
IMPORT_MAX_ROWS=10000
IMPORT_MAX_BYTES=10485760
IMPORT_TTL_HOURS=24
IDEMPOTENCY_RETENTION_DAYS=7
BACKUP_RETENTION_DAYS=7
BACKUP_DESTINATION=
BACKUP_DIRECTORY=
BACKUP_RECIPIENT=
BACKUP_SSH_IDENTITY_FILE=
BACKUP_SSH_KNOWN_HOSTS_FILE=
# Optional first scheduler startup date (KST YYYY-MM-DD). Blank persists first startup day.
SCHEDULER_START_DATE=
