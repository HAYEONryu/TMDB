# Host-side PostgreSQL 17 client + age required. This file must be 0600.
DJANGO_SECRET_KEY=
DATABASE_URL=
BACKUP_DIRECTORY=/srv/tmdb/backups
BACKUP_DESTINATION=ssh://backup@backup.example.com/srv/tmdb
BACKUP_RECIPIENT=
BACKUP_RETENTION_DAYS=7
BACKUP_SSH_IDENTITY_FILE=/srv/tmdb/secrets/backup-ssh-key
BACKUP_SSH_KNOWN_HOSTS_FILE=/srv/tmdb/secrets/known_hosts
# Keep the age decryption identity offline, outside the backup host.
TM_AGE_BIN=/srv/tmdb/app/.local/bin/age
TM_PG_BIN=/usr/lib/postgresql/17/bin
